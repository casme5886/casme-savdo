{
  "headers": [
    {
      "source": "/(click-logo|uzcard-logo|uzum-logo).(png|jpg)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000, stale-while-revalidate=86400" }]
    }
  ],
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/robots.txt", "destination": "/api/sitemap?kind=robots" },
    { "source": "/favicon.ico", "destination": "/api/sitemap?kind=favicon" },
    { "source": "/merchant-feed.xml", "destination": "/api/sitemap?kind=merchant" },
    { "source": "/merchant-feed-ru.xml", "destination": "/api/sitemap?kind=merchant&lang=ru" },
    { "source": "/product-image", "destination": "/api/sitemap?kind=product-image" },
    { "source": "/icon-192.png", "destination": "/api/sitemap?kind=icon&size=192" },
    { "source": "/icon-512.png", "destination": "/api/sitemap?kind=icon&size=512" },
    { "source": "/icon-maskable-512.png", "destination": "/api/sitemap?kind=icon&size=512&maskable=1" },
    { "source": "/apple-touch-icon-180.png", "destination": "/api/sitemap?kind=icon&size=180" },
    { "source": "/product/:key", "destination": "/api/sitemap?kind=page&type=product&key=:key" },
    { "source": "/brand/:key", "destination": "/api/sitemap?kind=page&type=brand&key=:key" },
    { "source": "/category/:key", "destination": "/api/sitemap?kind=page&type=category&key=:key" },
    { "source": "/banner/:key", "destination": "/api/sitemap?kind=page&type=banner&key=:key" },
    { "source": "/articles", "destination": "/api/sitemap?kind=page&type=articles" },
    { "source": "/article/:key", "destination": "/api/sitemap?kind=page&type=article&key=:key" },
    { "source": "/discounts", "destination": "/api/sitemap?kind=page&type=discounts" },
    { "source": "/hits", "destination": "/api/sitemap?kind=page&type=hits" },
    { "source": "/categories", "destination": "/api/sitemap?kind=page&type=categories" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
